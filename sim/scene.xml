        <geom name="goal_line_red" type="box" pos="6.975 0.000 0.001" size="0.025 4.500 0.001" contype="0" conaffinity="0" rgba="1 1 1 1"/>
        <geom name="halfway_line" type="box" pos="0.000 0.000 0.001" size="0.025 4.500 0.001" contype="0" conaffinity="0" rgba="1 1 1 1"/>
