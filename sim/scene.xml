        <geom name="corner_tl_5" type="box" pos="-6.529 4.438 0.001" size="0.067 0.025 0.001" euler="0 0 442.50" contype="0" conaffinity="0" material="line"/>
        <!-- Goal, blue end: posts and crossbar are solid, nets stop the ball -->
        <geom name="goal_blue_post_left" type="cylinder" fromto="-6.950 1.300 0 -6.950 1.300 1.75" size="0.05" material="post"/>
        <geom name="goal_blue_post_right" type="cylinder" fromto="-6.950 -1.300 0 -6.950 -1.300 1.75" size="0.05" material="post"/>
        <geom name="goal_blue_crossbar" type="cylinder" fromto="-6.950 -1.350 1.75 -6.950 1.350 1.75" size="0.05" material="post"/>
        <geom name="goal_blue_net_back" type="box" pos="-8.000 0 0.85" size="0.01 1.3 0.85" material="net"/>
        <geom name="goal_blue_net_left" type="box" pos="-7.500 1.3 0.85" size="0.5 0.01 0.85" material="net"/>
        <geom name="goal_blue_net_right" type="box" pos="-7.500 -1.3 0.85" size="0.5 0.01 0.85" material="net"/>
        <geom name="goal_blue_net_top" type="box" pos="-7.500 0 1.7" size="0.5 1.3 0.01" material="net"/>
        <!-- Goal, red end: posts and crossbar are solid, nets stop the ball -->
        <geom name="goal_red_post_left" type="cylinder" fromto="6.950 1.300 0 6.950 1.300 1.75" size="0.05" material="post"/>
        <geom name="goal_red_post_right" type="cylinder" fromto="6.950 -1.300 0 6.950 -1.300 1.75" size="0.05" material="post"/>
        <geom name="goal_red_crossbar" type="cylinder" fromto="6.950 -1.350 1.75 6.950 1.350 1.75" size="0.05" material="post"/>
        <geom name="goal_red_net_back" type="box" pos="8.000 0 0.85" size="0.01 1.3 0.85" material="net"/>
        <geom name="goal_red_net_left" type="box" pos="7.500 1.3 0.85" size="0.5 0.01 0.85" material="net"/>
        <geom name="goal_red_net_right" type="box" pos="7.500 -1.3 0.85" size="0.5 0.01 0.85" material="net"/>
        <geom name="goal_red_net_top" type="box" pos="7.500 0 1.7" size="0.5 1.3 0.01" material="net"/>

        <!-- Ball, FIFA size 3 -->
        <body name="ball" pos="0 0 0.095">
            <freejoint name="ball_joint"/>
            <geom name="ball_geom" type="sphere" size="0.095" mass="0.31" material="ball" condim="6" friction="0.8 0.02 0.005"/>
        </body>

        <!-- Robot 1: moves in x and y, turns on the spot -->
        <body name="robot1" pos="-2 0.5 0">
            <joint name="r1_x" type="slide" axis="1 0 0"/>
            <joint name="r1_y" type="slide" axis="0 1 0"/>
            <joint name="r1_yaw" type="hinge" axis="0 0 1"/>
            <geom name="r1_body" type="capsule" size="0.15 0.3" pos="0 0 0.46" mass="20" material="blue_team"/>
            <!-- Head with eyes: the eyes show which way the robot faces -->
            <geom name="r1_head" type="sphere" size="0.11" pos="0 0 1.0" contype="0" conaffinity="0" material="head"/>
            <geom name="r1_eye_left" type="sphere" size="0.022" pos="0.095 0.04 1.02" contype="0" conaffinity="0" material="eye"/>
            <geom name="r1_eye_right" type="sphere" size="0.022" pos="0.095 -0.04 1.02" contype="0" conaffinity="0" material="eye"/>
        </body>

        <!-- Robot 2: same as robot 1, facing the other way -->
        <body name="robot2" pos="2 -1 0" euler="0 0 180">
            <joint name="r2_x" type="slide" axis="1 0 0"/>
            <joint name="r2_y" type="slide" axis="0 1 0"/>
            <joint name="r2_yaw" type="hinge" axis="0 0 1"/>
            <geom name="r2_body" type="capsule" size="0.15 0.3" pos="0 0 0.46" mass="20" material="red_team"/>
            <geom name="r2_head" type="sphere" size="0.11" pos="0 0 1.0" contype="0" conaffinity="0" material="head"/>
            <geom name="r2_eye_left" type="sphere" size="0.022" pos="0.095 0.04 1.02" contype="0" conaffinity="0" material="eye"/>
            <geom name="r2_eye_right" type="sphere" size="0.022" pos="0.095 -0.04 1.02" contype="0" conaffinity="0" material="eye"/>
        </body>

    </worldbody>

    <!-- Speed controls for each robot: x, y and turning -->
    <actuator>
        <velocity name="r1_vx" joint="r1_x" kv="400" ctrlrange="-1 1"/>
        <velocity name="r1_vy" joint="r1_y" kv="400" ctrlrange="-1 1"/>
        <velocity name="r1_wz" joint="r1_yaw" kv="20" ctrlrange="-2 2"/>
        <velocity name="r2_vx" joint="r2_x" kv="400" ctrlrange="-1 1"/>
        <velocity name="r2_vy" joint="r2_y" kv="400" ctrlrange="-1 1"/>
        <velocity name="r2_wz" joint="r2_yaw" kv="20" ctrlrange="-2 2"/>
    </actuator>

</mujoco>
