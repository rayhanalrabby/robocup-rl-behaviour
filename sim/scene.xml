    <!-- Speed controls for each robot: x, y and turning -->
    <actuator>
        <velocity name="r1_vx" joint="r1_x" kv="400" ctrlrange="-1 1"/>
        <velocity name="r1_vy" joint="r1_y" kv="400" ctrlrange="-1 1"/>
        <velocity name="r1_wz" joint="r1_yaw" kv="20" ctrlrange="-2 2"/>
        <velocity name="r2_vx" joint="r2_x" kv="400" ctrlrange="-1 1"/>
        <velocity name="r2_vy" joint="r2_y" kv="400" ctrlrange="-1 1"/>
        <velocity name="r2_wz" joint="r2_yaw" kv="20" ctrlrange="-2 2"/>
