<mujoco model="robocup_simple">

    <!-- Physics settings: 5 ms step -->
    <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast"/>
    <!-- Starting view: whole field, centred, looking from the side -->
    <statistic center="0 -1 0" extent="10"/>
    <visual><global azimuth="90" elevation="-55"/></visual>

    <!-- Sky colour behind the field -->
    <asset>
        <texture name="sky" type="skybox" builtin="gradient" rgb1="0.55 0.7 0.9" rgb2="0.2 0.3 0.45" width="512" height="512"/>
    </asset>

    <worldbody>

        <!-- Fixed camera that shows the whole field -->
        <camera name="field_view" pos="0 -13 12" xyaxes="1 0 0 0 0.678 0.735"/>

        <!-- Light and floor. M-Field is 14 x 9 m, plus 1 m border on each side -->
        <light directional="true" pos="0 0 10" dir="0 0.3 -1" diffuse="0.8 0.8 0.8"/>
        <geom name="floor" type="plane" size="8 5.5 0.1" rgba="0.2 0.6 0.2 1" friction="1 0.005 0.0001"/>

        <!-- Field lines (visual only). Sizes from the HSL rules, M-Field. Lines are 5 cm wide -->
